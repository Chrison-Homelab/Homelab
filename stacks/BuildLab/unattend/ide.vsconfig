{
  "_comment": "BuildLab — MINIMAL .NET workloads for the VS Community IDE (vs_community), applied to 2019/2022/2026. Installs the IDE shell (CoreEditor is implicit) + MSBuild + Roslyn + the .NET SDK + .NET Framework 4.8 SDK/targeting pack + NuGet — enough to open & build .NET solutions without the full (heavy) ManagedDesktop workload. Add 'Microsoft.VisualStudio.Workload.ManagedDesktop' or '...NetWeb' here for the full IDE experience. No native/C++.",
  "version": "1.0",
  "components": [
    "Microsoft.Component.MSBuild",
    "Microsoft.VisualStudio.Component.Roslyn.Compiler",
    "Microsoft.VisualStudio.Component.NuGet",
    "Microsoft.NetCore.Component.SDK",
    "Microsoft.Net.Component.4.8.SDK",
    "Microsoft.Net.Component.4.8.TargetingPack"
  ]
}
