{
  "uid": "claude-code-usage",
  "title": "Claude Code Usage",
  "description": "Claude Code telemetry via OTLP -> otel-collector -> Prometheus. Machines report through https://otel.lab.chrison.dev with a bearer token; see stacks/Monitoring/.../otel-collector.yml.",
  "tags": [
    "homelab",
    "claude-code",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(claude_code_session_count_total, exported_instance)",
        "query": {
          "query": "label_values(claude_code_session_count_total, exported_instance)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Tokens (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{exported_instance=~\"$machine\"}[$__range]))",
          "legendFormat": "all machines",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Each Claude Code session reports its OWN cumulative counter and the series goes flat when the session ends, so increase() over a range returns 0 for anything short. max_over_time takes each session's final total and sums them, which is the real figure."
    },
