# Grafana — dashboards over Prometheus/Tempo/Loki.
#
# FIXED-UID: runs as uid 472, and its data dir on CT 4000 is owned by 472. keep-id maps the
# host `podman` user to 472 inside the container, so the migrated dir must be owned by
# `podman` (the migration chowns it once). NOT :U — that would chown recursively on every
# start (50 MB here, but the same rule keeps tempo's 3.2 GB sane).

[Unit]
Description=Grafana
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/grafana/grafana:latest
ContainerName=grafana
Network=monitoring.network
PublishPort=3000:3000
UserNS=keep-id:uid=472,gid=472

Environment=GF_SECURITY_ADMIN_USER=admin
Secret=grafana_admin_password,type=env,target=GF_SECURITY_ADMIN_PASSWORD
# Alert delivery. Grafana expands $HA_ALERT_WEBHOOK_URL inside the provisioned
# contact point, so the webhook id never lands in a file under git.
Secret=ha_alert_webhook_url,type=env,target=HA_ALERT_WEBHOOK_URL

# ── SSO against the homelab IdP (#485) ────────────────────────────────────────────────
# ROOT_URL MUST MATCH HOW THE BROWSER REACHES GRAFANA, because Grafana builds its OAuth
# redirect from it. Get it wrong and the flow fails at the callback with a redirect_uri
# mismatch that names neither value. LAN name, plain http, port 3000: there is no Pangolin
# resource for Grafana and this change does not add one — exposing it publicly is a separate
# decision, not a side effect of giving it SSO.
Environment=GF_SERVER_ROOT_URL=http://monitoring.homelab.chrison.internal:3000
Environment=GF_AUTH_GENERIC_OAUTH_ENABLED=true
Environment=GF_AUTH_GENERIC_OAUTH_NAME=authentik
Environment=GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
Environment="GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email"
Environment=GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://identity.chrison.dev/application/o/authorize/
Environment=GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://identity.chrison.dev/application/o/token/
Environment=GF_AUTH_GENERIC_OAUTH_API_URL=https://identity.chrison.dev/application/o/userinfo/
Secret=authentik_grafana_client_id,type=env,target=GF_AUTH_GENERIC_OAUTH_CLIENT_ID
Secret=authentik_grafana_client_secret,type=env,target=GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET

# THE GATE AND THE ROLE IN ONE EXPRESSION, which is more than Pulse can do. JMESPath over the
# claims; `a && b` yields b when a is truthy and `x || y` yields y when x is falsy, so this
# resolves to Admin for either group and to `false` for everyone else. STRICT then turns that
# `false` into a refused login rather than a default role — without it, an unlisted user would
# be signed up as a Viewer and the group binding would decide nothing.
#
# ⚠ QUOTED. systemd splits an unquoted Environment= on whitespace, which would truncate this
# to `contains(groups,` — verified the hard way on Pulse, where the same mistake silently
# removed the profile scope and with it the entire access gate.
Environment="GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups, 'homelab-admins') && 'Admin' || contains(groups, 'monitoring-admins') && 'Admin'"
Environment=GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true

# GF_AUTH_DISABLE_LOGIN_FORM IS DELIBERATELY UNSET. GF_SECURITY_ADMIN_PASSWORD stays a working
# break-glass login: authentik's recovery path is unproven by choice, and Grafana is part of
# how you would diagnose an outage. #485's rule is add the SSO path, never remove the local one.

Volume=/home/podman/monitoring/data/grafana:/var/lib/grafana
Volume=/home/podman/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=/home/podman/monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
AutoUpdate=registry

[Service]
ExecStartPre=/usr/bin/mkdir -p /home/podman/monitoring/data/grafana
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
