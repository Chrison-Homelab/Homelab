# exportarr (sonarr) — Prometheus exporter for the *arr app. One instance per app.
#
# ContainerName is load-bearing: prometheus.yml scrapes exportarr-sonarr:9709.
# The API key is a podman secret; the URL is plain config (an internal address, not a secret).
# Replaced the archived ghcr.io/onedr0p/servarr_exporter image.

[Unit]
Description=exportarr (sonarr)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/onedr0p/exportarr:latest
ContainerName=exportarr-sonarr
Network=monitoring.network
# DISTROLESS uid 65532. Without this, crun refuses to start it ("setgroups: Invalid argument")
# because container uid 65532 is outside the subuid window the LXC's own 65536-uid map allows.
# keep-id aligns the host `podman` user with that single uid, which is all a one-process
# container needs. The image PULL additionally needs storage.conf's ignore_chown_errors, which
# the provisioner writes (#303, platform gotcha 12).
UserNS=keep-id:uid=65532,gid=65532
PublishPort=9709:9709
Environment=PORT=9709
Environment=URL=http://10.10.250.29:8989
Secret=sonarr_api_key,type=env,target=API_KEY
Exec=sonarr
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
