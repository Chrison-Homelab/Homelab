# secrets.env.local.template — schema for the monitoring stack's .env.local.
# Generated by `scripts/secrets-sync.sh <out> <this-template>` (bws + Keychain token,
# SM project "Homelab"): blank keys are filled from Secrets Manager; non-secret lines
# (URLs, user, port) pass through literally. deploy/install.sh runs this before shipping
# .env.local host→CT. NEVER put a secret value here — committed to git.

# ── Grafana (admin password from SM; user + port are non-secret config) ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# ── *arr exporters (exportarr) — API keys from SM; URLs are internal, literal ──
RADARR_URL=http://10.10.48.217:7878
RADARR_API_KEY=
SONARR_URL=http://10.10.250.29:8989
SONARR_API_KEY=
PROWLARR_URL=http://10.10.201.184:9696
PROWLARR_API_KEY=
