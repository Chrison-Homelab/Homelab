# Authentik server — the web UI and the OIDC/SAML endpoints everything else will talk to.
#
# Same image as the worker; the two differ only by the argument. The image entrypoint is
# `dumb-init -- ak`, so `Exec=server` appends to it rather than replacing it.
#
# NO REDIS. Authentik removed it in 2025.10 — caching, the embedded outpost and WebSockets
# all moved to Postgres. Any guide showing a redis service predates that, and adding one
# back does nothing except cost memory.
#
# FIXED-UID CASE: the image declares User=1000. Conveniently the host `podman` user is also
# uid 1000, so `keep-id:uid=1000,gid=1000` lines the two up and /data is writable. The same
# mapping is on the worker, which is what lets both share /data.
#
# PUBLISHES :9000 (HTTP) ONLY. :9443 is Authentik's own TLS, which we do not want — TLS is
# terminated at Traefik/Pangolin, and publishing a second, separately-certificated port
# invites something to be pointed at the wrong one.
#
# ⚠ SECRET KEY. AUTHENTIK_SECRET_KEY signs sessions and encrypts stored values. Rotating it
# logs everyone out; LOSING it is worse than losing the database, because encrypted columns
# cannot be read back without it. It lives in Bitwarden and reaches here as a podman secret.

[Unit]
Description=Authentik server
Documentation=https://docs.goauthentik.io/install-config/install/docker-compose
After=network-online.target
Wants=network-online.target
# Migrations run at start and need the database actually accepting connections, not merely
# started — hence the healthcheck on the postgres unit.
Requires=authentik-postgresql.service
After=authentik-postgresql.service

[Container]
# authentik 2026.8.0
# ⚠ PINNED BY DIGEST, NOT BY TAG — and the tag genuinely does not work here.
#
# ghcr.io/goauthentik/server:2026.8.0 is a NESTED OCI index: the top-level index's per-arch
# entries are themselves `application/vnd.oci.image.index.v1+json`, not manifests. Podman
# 5.4.2 (what Debian 13 ships) resolves the platform entry, finds another index, and gives up:
#
#   Error: copying system image from manifest list: Unexpectedly received a manifest list
#          instead of a manifest for a single image
#
# which presents as a unit that crash-loops on pull with status=125 and never starts. There is
# no Docker Hub mirror to fall back to.
#
# The digest below is the linux/amd64 SINGLE-ARCH manifest INSIDE that nested index —
# verified pulled on CT 2014. Every node here is amd64, so arch-pinning costs nothing today.
#
# TO BUMP THE VERSION, resolve the new inner digest rather than editing a tag:
#   tag=2026.9.0; repo=goauthentik/server
#   tok=$(curl -s "https://ghcr.io/token?scope=repository:$repo:pull" | jq -r .token)
#   amd=$(curl -s -H "Authorization: Bearer $tok" -H "Accept: application/vnd.oci.image.index.v1+json" \
#         "https://ghcr.io/v2/$repo/manifests/$tag" \
#         | jq -r '.manifests[] | select(.platform.architecture=="amd64" and .platform.os=="linux") | .digest')
#   curl -s -H "Authorization: Bearer $tok" -H "Accept: application/vnd.oci.image.index.v1+json" \
#        "https://ghcr.io/v2/$repo/manifests/$amd" \
#        | jq -r '.manifests[] | select(.mediaType|test("image.manifest")) | .digest'
#
# Revisit if podman ever gains nested-index support; a plain tag is easier to read.
Image=ghcr.io/goauthentik/server@sha256:21000cebe8e51eca0620034096586d675cedec8925ac750f7f8966d86eeb0da0
ContainerName=authentik-server
Network=authentik.network
Exec=server

Secret=authentik_secret_key,type=env,target=AUTHENTIK_SECRET_KEY
Secret=authentik_pg_password,type=env,target=AUTHENTIK_POSTGRESQL__PASSWORD
# OIDC client credentials for the Pangolin application, consumed by the blueprint's `!Env`
# tags. Fixed by us rather than minted by Authentik, because Pangolin's IdP registration needs
# the identical pair — generating them here and reading them out of a UI is the manual step
# this avoids.
Secret=authentik_pangolin_client_id,type=env,target=AUTHENTIK_PANGOLIN_CLIENT_ID
Secret=authentik_pangolin_client_secret,type=env,target=AUTHENTIK_PANGOLIN_CLIENT_SECRET
# Pulse's pair, for the same reason: the blueprint declaring the Pulse provider is applied in
# this container, so `!Env AUTHENTIK_PULSE_CLIENT_ID` reads it from here. Every future Tier-1
# app (#485) adds two more lines to this list — that is the cost of the credentials never
# being copied between two UIs.
Secret=authentik_pulse_client_id,type=env,target=AUTHENTIK_PULSE_CLIENT_ID
Secret=authentik_pulse_client_secret,type=env,target=AUTHENTIK_PULSE_CLIENT_SECRET
Secret=authentik_grafana_client_id,type=env,target=AUTHENTIK_GRAFANA_CLIENT_ID
Secret=authentik_grafana_client_secret,type=env,target=AUTHENTIK_GRAFANA_CLIENT_SECRET
Secret=authentik_forgejo_client_id,type=env,target=AUTHENTIK_FORGEJO_CLIENT_ID
Secret=authentik_forgejo_client_secret,type=env,target=AUTHENTIK_FORGEJO_CLIENT_SECRET
Secret=authentik_plex_owner_token,type=env,target=PLEX_OWNER_TOKEN
Secret=authentik_plex_machine_identifier,type=env,target=PLEX_MACHINE_IDENTIFIER
# Must match ContainerName= on the postgres unit — resolved by aardvark-dns on the shared
# network, not by anything in this file.
Environment=AUTHENTIK_POSTGRESQL__HOST=authentik-postgresql
Environment=AUTHENTIK_POSTGRESQL__NAME=authentik
Environment=AUTHENTIK_POSTGRESQL__USER=authentik
Environment=TZ=Pacific/Auckland

PublishPort=9000:9000

# BLUEPRINTS — the IaC path for groups, providers, applications and policy bindings (#468).
# Authentik discovers *.yaml anywhere under /blueprints and applies them, so mounting our tree
# at /blueprints/custom makes the access model a reviewable file in git instead of a sequence
# of clicks nobody can diff. Read-only: Authentik has no reason to write here, and a writable
# mount would let a UI edit silently diverge from the file that is supposed to define it.
#
# ⚠ SOURCED FROM ITS OWN DIRECTORY, NOT FROM /home/podman/authentik. The engine's asset push
# finishes with `chown -R <user> <assetsTarget>`, so pointing assetsTarget at the shared
# authentik directory would recursively chown the Postgres data dir — which runs as uid 999
# under keep-id — to uid 1000, and Postgres refuses to start on wrong ownership.
Volume=/home/podman/authentik-blueprints:/blueprints/custom:ro
Volume=/home/podman/authentik/data:/data
Volume=/home/podman/authentik/custom-templates:/templates
UserNS=keep-id:uid=1000,gid=1000

# Upstream sets shm_size: 512mb on both server and worker.
ShmSize=512m

HealthCmd=ak healthcheck
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
# Generous: a first boot runs the full migration set before the app answers.
HealthStartPeriod=120s

[Service]
ExecStartPre=/usr/bin/mkdir -p /home/podman/authentik/data /home/podman/authentik/custom-templates /home/podman/authentik-blueprints
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
