# Template for stack.env — copy to `stack.env` and fill in, then:
#   docker compose --env-file stack.env up -d
#
# stack.env is gitignored (holds demo passwords). These are throwaway
# credentials for a LAN-only bake-off, but still don't commit them. Generate
# strong values with e.g. `openssl rand -base64 24`.

# ── WooCommerce (WordPress + MariaDB) ─────────────────────────────────────────
WOO_DB_PASSWORD=
WOO_DB_ROOT_PASSWORD=
# WordPress admin created on first boot. Login at http://<host>:8081/wp-admin
WOO_ADMIN_USER=admin
WOO_ADMIN_PASSWORD=
WOO_ADMIN_EMAIL=admin@example.com

# ── nopCommerce (Postgres) ────────────────────────────────────────────────────
# You'll type this password into the /install wizard on first run — see README.
NOP_DB_PASSWORD=

# ── Bagisto ───────────────────────────────────────────────────────────────────
# No secrets: the all-in-one image ships fixed demo creds
# (admin@example.com / admin123). Change them after first login.
