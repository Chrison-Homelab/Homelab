# Leapmotor Mate environment — copy to `.env` on the LXC and fill in.
# The real `.env` is gitignored (*.env); only this .example is tracked.
#
# NOTE: the Leapmotor account email / password / operation-PIN are NOT set here.
# They're entered once in Mate's first-run web wizard and stored (encrypted) in
# ./data. This file only covers the container/runtime knobs.

# --- web UI ---
MATE_HOST_PORT=4000

# Password gate for the web UI. Leave blank for no auth (LAN-only). Set it if
# this is ever exposed. Generate with `bw generate` and store in Bitwarden
# (see memory: bitwarden-cli-secrets).
MATE_AUTH_PASSWORD=

# Encryption key for stored credentials. Leave blank to let Mate auto-generate
# one into ./data on first boot. Set it explicitly (and back it up) if you want
# the stored account creds to survive wiping ./data.
MATE_SECRET_KEY=

# --- runtime ---
TZ=Pacific/Auckland

# Set to 1 to boot with sample data — no real account or certs needed. Comment
# out / set empty for normal operation.
# MATE_DEMO=1

# Pin the image instead of tracking latest, if you want manual control.
# MATE_IMAGE=ghcr.io/protossblaster/leapmotor-mate:latest
