# Youtarr environment — copy to `.env` on the CT and fill in.
# The real `.env` is gitignored (*.env); only this .example is tracked.
# Generate DB_ROOT_PASSWORD with `bw generate` and store it in Bitwarden
# (see memory: bitwarden-cli-secrets). Internal-only DB, but don't ship a default.

# --- storage (required) ---
# NFS mount of the volume4 `youtube` subpath (declared in ../youtarr.lxc.yaml).
YOUTUBE_OUTPUT_DIR=/mnt/youtube

# --- database (bundled MariaDB; root-only, internal to youtarr-network) ---
DB_ROOT_PASSWORD=__set_me__
DB_NAME=youtarr
DB_PORT=3321

# --- web UI ---
YOUTARR_HOST_PORT=3087
# AUTH_ENABLED=true            # leave true (internal-only, but UI has its own login)
# AUTH_PRESET_USERNAME=
# AUTH_PRESET_PASSWORD=

# --- runtime ---
TZ=Pacific/Auckland
LOG_LEVEL=info
# YOUTARR_UID=0
# YOUTARR_GID=0
# PLEX_URL=http://<plex-host>:32400   # optional pre-config; otherwise set in the UI
# YOUTARR_IMAGE=dialmaster/youtarr:latest
