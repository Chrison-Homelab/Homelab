[Unit]
Description=Daily SoulVoice attendance claim

[Timer]
# Early, with a retry later the same day if the first run fails, so a transient
# outage does not cost the streak. Well clear of the 00:00 site rollover.
OnCalendar=*-*-* 09:20:00
OnCalendar=*-*-* 19:20:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
