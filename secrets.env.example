# Homelab secrets — copy to `secrets.env` (gitignored) and fill in real values.
# This ONE file is the canonical source for all CLIs and the hub. Source it
# before running any tool:
#
#   set -a && . ./secrets.env && set +a
#
# The tools read OS env vars (not a file directly), so sourcing this is what
# wires them up. (The per-submodule vendor/*/secrets.env files are only for
# developing those submodules standalone — e.g. UniFi against the test container.)

# ── Proxmox VE — proxmoxsharp ──
PROXMOX_BASE_URL=https://192.168.179.3:8006/api2/json
PROXMOX_TOKEN_ID="root@pam!your-token"
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=false

# ── Synology DSM — synosharp ──
SYNOLOGY_BASE_URL=https://192.168.179.11:5001
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=
SYNOLOGY_VERIFY_TLS=false

# ── UniFi Network — unifisharp — LIVE Cloud Gateway Ultra ──
# API key (X-API-KEY): UniFi console → Settings → Control Plane → Integrations →
# Create API Key. Until set, live UniFi reads go through the `unifi` MCP instead.
UNIFI_BASE_URL=https://192.168.178.1/proxy/network/integration
UNIFI_API_KEY=
UNIFI_VERIFY_TLS=false
# The `unifi` MCP (.mcp.json) uses local-API env names instead of UNIFI_BASE_URL:
# it needs UNIFI_LOCAL_HOST (host only) + shares UNIFI_API_KEY. Same controller.
UNIFI_LOCAL_HOST=192.168.178.1

# ── Cloudflare (chrison.dev zone — add-only, never touch existing) ──
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Optional: a DNS-only-scoped token for Traefik's DNS-01 wildcard challenge (Pangolin
# EE, ADR-0007). Falls back to CF_API_TOKEN if unset.
CF_DNS_API_TOKEN=

# ── Pangolin (Core SSO front door — ADR-0007 / #168) ──
# Org integration-API key (created in the dashboard post-setup) — declarative resource
# reconcile; resources are skipped until it exists.
PANGOLIN_API_KEY=
# Free personal-use Enterprise Edition license (OIDC/RBAC). Activated ONCE by hand at
# /admin/license (UI-only — no API/env path).
PANGOLIN_LICENSE_KEY=

# ── GitHub (chrison-dev org) ──
GH_ORG=Chrison-dev
GITHUB_PACKAGES_PAT=
GH_RUNNER_PAT=

# ── Media stack / arr-wire (#159) ──
# qBittorrent WebUI creds the provisioner sets on CT 5104 (also how sonarr/radarr
# authenticate as a download client). QBIT_USER defaults to 'admin' if unset.
QBIT_USER=admin
QBIT_PASSWORD=
# *arr WebUI Forms-auth: shared username + per-app passwords the provisioners set
# (#178). ARR_USER defaults to 'csimon'. Generate with `bw generate` + store in Bitwarden.
ARR_USER=csimon
SONARR_PASSWORD=
RADARR_PASSWORD=
PROWLARR_PASSWORD=
BAZARR_PASSWORD=
# Bazarr subtitle provider account (opensubtitles.com) — migrated from old bazarr.
BAZARR_OPENSUBTITLES_USER=
BAZARR_OPENSUBTITLES_PASSWORD=
