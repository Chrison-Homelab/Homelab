<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- nuget.org ONLY. Everything this repo builds resolves publicly:
           - Fallout.* (the build system) — 10.4.0, the current stable line. It used to come
             from the Fallout-build GitHub Packages feed because the pin was a
             2026.1.0-preview edge build from the abandoned CalVer line; on 10.4.0 that
             private feed, and the PAT it needed, are gone (#390).
           - Chrison.ProxmoxSharp / Chrison.UnifiSharp / Chrison.SynoSharp — our own clients,
             published publicly under the Chrison.* prefix.
           - YamlDotNet, JsonSchema.Net, Serilog, xunit, ...
         No packageSourceCredentials, and no GITHUB_PACKAGES_PAT anywhere in the build path. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
