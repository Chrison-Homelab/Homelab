<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Homelab.Infrastructure.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <!-- Parse the YAML app-catalogue / shapes the same way the engine does (#48 tests). -->
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../engine/Homelab.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema drift tripwire reads the canonical schema at test time (#43 tests). -->
    <None Include="../schema/shape.schema.json" Link="schema/shape.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
