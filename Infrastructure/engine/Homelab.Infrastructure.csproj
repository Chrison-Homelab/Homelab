<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Homelab.Infrastructure</RootNamespace>
    <AssemblyName>homelab-infra</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Let the test project exercise internal render helpers (e.g. the Pangolin
         Docker-EE compose/Traefik renderers) directly. -->
    <InternalsVisibleTo Include="Homelab.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Consume the published Chrison.ProxmoxSharp package from nuget.org (public;
         Chrison.* prefix — the bare ProxmoxSharp ID is taken there by an unrelated
         project). Assembly name/namespace are unchanged (ProxmoxSharp). Pinned to an
         exact prerelease for deterministic restores; bump explicitly when adopting new
         code. Carries the LXC lifecycle write path (PctWriter, #149). -->
    <PackageReference Include="Chrison.ProxmoxSharp" Version="0.2.0-preview.5" />
    <!-- UniFi discover surface + the legacy write adapter (UnifiSharp.Legacy:
         port-forwards/firewall/networks/clients). From nuget.org (Chrison.* prefix);
         assembly/namespace unchanged (UnifiSharp). Pinned exactly (like
         Chrison.ProxmoxSharp). 0.2.0 adds X-API-KEY auth — without it the legacy
         adapter requires UNIFI_USERNAME/UNIFI_PASSWORD, which secrets.env does not
         carry, so converge-unifi could not authenticate at all (#416) — plus the
         rest/user endpoints the DHCP-reservation reconcile is built on. -->
    <PackageReference Include="Chrison.UnifiSharp" Version="0.3.0" />
    <!-- YAML parsing for homelab/v1 shapes (BL-010 converge). -->
    <PackageReference Include="YamlDotNet" Version="16.*" />
    <!-- JSON Schema (draft-2020-12) validation of homelab/v1 shapes against
         the canonical Infrastructure/schema/shape.schema.json (#43). -->
    <PackageReference Include="JsonSchema.Net" Version="9.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The canonical shape contract. Copied next to the engine so the validator
         can resolve it at runtime regardless of the working directory. -->
    <None Include="..\schema\shape.schema.json" Link="schema\shape.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
