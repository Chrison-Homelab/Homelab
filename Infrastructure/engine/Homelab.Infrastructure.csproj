<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Homelab.Infrastructure</RootNamespace>
    <AssemblyName>homelab-infra</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consume the published ProxmoxSharp package from GitHub Packages.
         Float to the latest prerelease (published on every push to main);
         pin to a stable version when one is tagged. -->
    <PackageReference Include="ProxmoxSharp" Version="0.2.0-preview.*" />
    <!-- UniFi discover surface (sites/networks/firewall/devices/clients). -->
    <PackageReference Include="UnifiSharp" Version="0.1.0-preview.*" />
    <!-- YAML parsing for homelab/v1 shapes (BL-010 converge). -->
    <PackageReference Include="YamlDotNet" Version="16.*" />
    <!-- JSON Schema (draft-2020-12) validation of homelab/v1 shapes against
         the canonical Infrastructure/schema/shape.schema.json (#43). -->
    <PackageReference Include="JsonSchema.Net" Version="9.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The canonical shape contract. Copied next to the engine so the validator
         can resolve it at runtime regardless of the working directory. -->
    <None Include="..\schema\shape.schema.json" Link="schema\shape.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
