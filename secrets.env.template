# ════════════════════════════════════════════════════════════════
# secrets.env.template — CANONICAL schema for secrets.env.
# Non-secret values are literal here; secret values are BLANK and get
# filled from Bitwarden Secrets Manager (project "Homelab") by:
#   scripts/secrets-sync.sh     (macOS/Linux)
#   scripts/secrets-sync.ps1    (Windows)
# NEVER put a secret value in this file — it is committed to git.
# ════════════════════════════════════════════════════════════════

# Cloudflare
CF_API_TOKEN=
CF_ACCOUNT_ID=
# GitHub org
GH_ORG=Chrison-Homelab
GH_RUNNER_PAT=
# ────────────────────────────────────────────────────────────────
# Home edge addressing — the two facts about the HOUSE (rather than about the
# cluster) that shapes need. Referenced as ${HOME_WAN_IP} / ${HOME_WAN_IPV6_PREFIX}
# from spec.config and expanded at converge time (Infrastructure/engine/Shapes/ShapeVars.cs).
#
# Blank here ON PURPOSE — this repo is PUBLIC. Not because the values are unknowable
# (the grey-cloud wildcard A records publish the IPv4: `dig x.lab.chrison.dev`), but so
# a public repo and its public Actions logs don't hand it over for free. GitHub masks
# SECRETS in logs; it does not mask variables, and converge prints publicIp in Preview.
#
# HOME_WAN_IP          — home WAN IPv4, the public :443 port-forward (ADR-0007, #221)
# HOME_WAN_IPV6_PREFIX — DHCPv6-PD /56 from Quic, base address only (no /56 suffix);
#                        the whole house draws its /64s from it. NEVER widen to the /48:
#                        that is Quic's pool, i.e. other customers.
# Update BOTH here (Bitwarden SM) and the Homelab repo secret of the same name when
# the ISP moves them, then re-run the Core deploy.
HOME_WAN_IP=
HOME_WAN_IPV6_PREFIX=
# ────────────────────────────────────────────────────────────────
# Network services — sourced by the CLIs (proxmoxsharp / synosharp /
# unifisharp). Source this file before running any tool:
#   set -a && . ./secrets.env && set +a
# ────────────────────────────────────────────────────────────────

# Proxmox VE (proxmoxsharp). Addressed BY NAME since #37 — the nodes moved to
# VLAN 1000 on 2026-08-02, and these are UniFi local-DNS records, so a future
# re-address needs no change here. Still VERIFY_TLS=false: this is the node's own
# self-signed cert. (https://proxmox.chrison.dev is the TLS-valid public path, via
# the Core cloudflared tunnel — use that from outside the LAN.)
PROXMOX_BASE_URL=https://hpe-01.homelab.chrison.internal:8006/api2/json
PROXMOX_TOKEN_ID="root@pam!claude-mcp"
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=false

# Synology DSM (synosharp). By name for the same reason — the NAS moved to
# 10.0.0.10 on VLAN 1000 (#340) and the DNS record is attached to its DHCP
# reservation, so name and lease move together.
SYNOLOGY_BASE_URL=https://nas.homelab.chrison.internal:5001
SYNOLOGY_USER=homelab
SYNOLOGY_PASSWORD=
SYNOLOGY_VERIFY_TLS=false

# UniFi Network (unifisharp) — LIVE Cloud Gateway Ultra.
# Needs a Network Integration API key (X-API-KEY), generated in the UniFi
# console: Settings → Control Plane → Integrations → Create API Key.
# Until set, live UniFi reads go through the unifi MCP (username/password).
# DELIBERATELY an IP, not a name: this host IS the DNS server. Pointing the
# controller's own address at a record it serves is circular — if UniFi is down or
# mid-boot, name resolution fails and you cannot reach the thing you need to fix.
UNIFI_BASE_URL=https://192.168.178.1/proxy/network/integration
UNIFI_VERIFY_TLS=false
# The `unifi` MCP (.mcp.json) uses local-API env names, not UNIFI_BASE_URL —
# it interpolates ${UNIFI_LOCAL_HOST} (+ shares UNIFI_API_KEY above). Without
# this it launches with an empty host → "nodename nor servname". Same controller.
UNIFI_LOCAL_HOST=192.168.178.1   # IP on purpose — see the note above
UNIFI_API_KEY=
# These two are ALSO what the legacy WRITE adapter uses (`converge-unifi`, and the
# DHCP-reservation reconcile): from Chrison.UnifiSharp 0.2.0 the legacy API accepts
# X-API-KEY and derives its site URL from UNIFI_LOCAL_HOST. Before that it demanded
# UNIFI_USERNAME + UNIFI_PASSWORD, which this file has never carried — so converge-unifi
# could not authenticate on ANY machine set up from here, including a bare-metal rebuild
# restoring the public :443 port-forward (#416). Session auth still works and is what
# `.containers/unifi` needs; set UNIFI_LEGACY_BASE_URL + UNIFI_USERNAME + UNIFI_PASSWORD
# for the test container only — never pointed at the live console, since the destructive
# UnifiSharp live tests key off exactly those variables.

# Home Assistant
HOMEASSISTANT_TOKEN=
# CF Access service token — non-interactive API access to proxmox.chrison.dev (Core tunnel)
CF_ACCESS_PROXMOX_CLIENT_ID=
CF_ACCESS_PROXMOX_CLIENT_SECRET=

# Homelab.Stacks.Media tunnel connector token (CT 5108)
CF_TUNNEL_MEDIA_TOKEN=
PANGOLIN_API_KEY=

# ── Media stack / arr-wire (#159) — qBittorrent WebUI creds ──
QBIT_USER=admin
QBIT_PASSWORD=
SONARR_PASSWORD=
RADARR_PASSWORD=
PROWLARR_PASSWORD=
ARR_USER=csimon
BAZARR_PASSWORD=
BAZARR_OPENSUBTITLES_USER=Chrison
BAZARR_OPENSUBTITLES_PASSWORD=

# audiobookshelf (CT 5112) — root admin, reset to bw-generated pw 2026-06-22
ABS_USER=root
ABS_PASSWORD=

# Hardcover API key (metadata provider for shelfmark) — from BW hardcover.app, 2026-06-22
HARDCOVER_API_KEY=

# Pangolin Enterprise license (free personal tier, <$100k rev) — #168
PANGOLIN_LICENSE_KEY=

# Authentik — the homelab IdP on CT 2014 (#469). Both reach the CT as podman secrets.
#
# ⚠ AUTHENTIK_SECRET_KEY is not a rotatable password. It signs sessions AND encrypts values
# stored in the database, so losing it is worse than losing the database itself — the rows
# survive but cannot be decrypted. Rotating it logs every session out.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASSWORD=

# OIDC client credentials for the Pangolin application in Authentik (#468). BOTH sides read
# these same two values: Authentik's blueprint pins them via `!Env`, and Pangolin's IdP
# registration is created with them. Fixing the pair in Secrets Manager is what removes the
# "copy the client secret out of one UI and paste it into another" step — rotate by changing
# them here and re-running deploy-core, which updates both ends in one pass.
AUTHENTIK_PANGOLIN_CLIENT_ID=
AUTHENTIK_PANGOLIN_CLIENT_SECRET=

# OIDC client credentials for Pulse (#485). Same two-ended arrangement as Pangolin's:
# authentik's blueprint pins them via `!Env`, and Pulse reads them as OIDC_CLIENT_ID /
# OIDC_CLIENT_SECRET. Setting those env vars also LOCKS the fields in Pulse's own UI, so the
# deployed configuration cannot be edited out from under this file.
AUTHENTIK_PULSE_CLIENT_ID=
AUTHENTIK_PULSE_CLIENT_SECRET=

# OIDC client credentials for Grafana (#485). Read in three places: authentik's blueprint via
# `!Env`, and Grafana as GF_AUTH_GENERIC_OAUTH_CLIENT_ID / _SECRET. Note that authentik needs
# EVERY client's pair, not just its own — the blueprint declaring a provider is applied inside
# the authentik container, so a pair present only on the consumer's host resolves to null and
# authentik rejects the entire blueprint file.
AUTHENTIK_GRAFANA_CLIENT_ID=
AUTHENTIK_GRAFANA_CLIENT_SECRET=

# OIDC client credentials for Forgejo (#485). The forgejo provisioner passes these to
# `forgejo admin auth add-oauth`; authentik's blueprint pins the same pair via `!Env`.
AUTHENTIK_FORGEJO_CLIENT_ID=
AUTHENTIK_FORGEJO_CLIENT_SECRET=

# Plex as an identity SOURCE on authentik (#316) — not an OIDC client, so no id/secret pair.
# Both values reach CT 2014 as podman secrets and are read by the blueprint via `!Env`.
#
# PLEX_OWNER_TOKEN        — the SERVER OWNER's plex.tv token. authentik calls
#                           /api/v2/friends and /api/v2/user with it to decide who may sign
#                           in, so it is a credential for the whole Plex account, not a
#                           scoped one. Plex has no way to issue a narrower token.
#                           Rotating it in Plex invalidates this immediately; a stale value
#                           does not fail loudly — logins just start being refused.
# PLEX_MACHINE_IDENTIFIER — our server's `clientIdentifier`. NOT a secret in the credential
#                           sense, but it is a fact about the house rather than the cluster,
#                           and this repo is PUBLIC — same reasoning as HOME_WAN_IP above.
#
# ⚠ Both must be listed in the server AND worker quadlets, not only in the shape's
# `config.secrets`. Declaring them there creates the podman secret; without the quadlet
# `Secret=` lines `!Env` resolves null and authentik rejects the ENTIRE blueprint file
# (#497, and again on #528). The worker is what applies blueprints, so it is the one that
# must have them.
PLEX_OWNER_TOKEN=
PLEX_MACHINE_IDENTIFIER=

# ── Shell host (CT 3003) — RETIRED, deliberately left here as a tombstone (#479).
#
# SHELL_USER_PASSWORD used to give the login account a password, because Pangolin's
# `mode: ssh` resource asks for the HOST's credentials after the SSO gate and a borrowed
# machine has no key file to upload. That resource is gone: the public surface is now
# Zellij's own web client, which needs no OS password at all.
#
# Leaving it OUT is the desired state. The provisioner reads its absence as an instruction:
# it locks the account AND drops /etc/ssh/sshd_config.d/10-homelab-keyonly.conf with
# PasswordAuthentication no — so the host refuses password auth outright rather than merely
# having no password to guess. Re-adding the key below reverses both.
#
# The corresponding Bitwarden Secrets Manager entry is now unused. Deleting it is yours to
# do (this file cannot, and should not, delete from the vault).

# ── PowerOrchestrator (#191) — dry-run; presence = iPhone Chris ──
# Armed 2026-09-05 (#191): desktop-01 runs nothing always-on any more and the sentinels keep 2 of 3
# votes. Comment stays on its own line: deploy.sh copies ORCH_* lines VERBATIM into a systemd
# EnvironmentFile, which does not strip trailing comments.
ORCH_ARMED=true
ORCH_PRESENCE_MACS=12:c1:06:38:23:5b

# Observability: OTLP collector on the monitoring podman host (CT 4001 @ hpe-01) — #222/#303.
# A NAME, not an IP: the address moved once already in the podman migration, and the point
# of homelab.chrison.internal (UniFi local DNS) is that it never has to move again.
# Read by PowerOrchestrator/deploy/install.sh (OTEL_EXPORTER_* key) → orchestrator emits here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://monitoring.homelab.chrison.internal:4317

# Leapmotor Mate web-UI password (SmartHome podman host CT 6004) — #285.
# Consumed as a podman SECRET (not an env file) by podman-host/quadlets/leapmotor-mate.container.
# NOTE: MATE_SECRET_KEY is deliberately NOT registered — Mate auto-generates it into its
# data dir when unset, and it must stay paired with that database (see podman-host/README.md).
MATE_AUTH_PASSWORD=

# ── Youtarr on the Media podman host (CT 5114) — #302 ──
# Consumed as podman SECRETS (not an env file) by stacks/Media/podman-host/quadlets/.
YOUTARR_DB_ROOT_PASSWORD=
YOUTARR_AUTH_USERNAME=
YOUTARR_AUTH_PASSWORD=

# ── Krautwatch on the Media podman host (CT 5114) ──
# Consumed as podman SECRETS by stacks/Media/podman-host/quadlets/.
# The connection string is stored whole because a quadlet cannot expand a secret inside another
# variable's value. Its password must match KRAUTWATCH_DB_PASSWORD.
#   KRAUTWATCH_DB_CONNECTIONSTRING=Host=krautwatch-db;Port=5432;Username=postgres;Password=<same>;Database=krautwatch
KRAUTWATCH_DB_PASSWORD=
KRAUTWATCH_DB_CONNECTIONSTRING=
# The single API key Sonarr and Prowlarr authenticate with. Unset leaves the surface open.
KRAUTWATCH_APIKEY=
# Optional — TheTVDB matching. Absent degrades matching to titles rather than failing.
KRAUTWATCH_TVDB_APIKEY=

# ── Monitoring stack on the podman host (CT 4001) — #303 ──
# Consumed as podman SECRETS by stacks/monitoring/podman-host/quadlets/. These previously
# lived only in the stack's own .env.local on CT 4000 (see secrets.env.local.template),
# which is retired with that CT. Non-secret config (GF_SECURITY_ADMIN_USER, GRAFANA_PORT,
# the *arr URLs) is set as Environment= in the quadlets instead.
GF_SECURITY_ADMIN_PASSWORD=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# ── Pulse fleet monitoring on the podman host (CT 4001) — agent enrolment ──
# PULSE_API_TOKEN is Pulse's own API token (scope "*"). The unified agent enrols with
# the SAME token — agent registration needs HOST_AGENT_SCOPE, which "*" covers — so
# there is no second secret to mint or rotate.
#
# Consumed by src/Proxmox/install-pulse-agent.sh (+ .ps1) and
# src/Synology/install-pulse-agent.sh. Those pass it to the upstream installer via
# --token-file, never --token: argv is world-readable through /proc on these hosts.
PULSE_URL=http://monitoring.homelab.chrison.internal:7655
PULSE_API_TOKEN=

# ── Beszel (evaluation alongside Pulse, #517) ──
# BESZEL_AGENT_TOKEN is the hub's UNIVERSAL enrolment token (Settings > Tokens). It lets
# an agent register without pre-registering the machine, which is what makes a scripted
# per-host install possible at all.
#
# BESZEL_HUB_KEY is the hub's ssh-ed25519 PUBLIC key, which each agent authorises so only
# our hub can talk to it. Public material, so not a secret in the cryptographic sense —
# but it lives here anyway so enrolment resolves from ONE place instead of half from SM
# and half from a wiki page nobody updated.
#
# Consumed by src/Proxmox/install-beszel-agent.sh and src/Synology/install-beszel-agent.sh.
# Both refuse a token in argv for the same reason the Pulse scripts do: argv is
# world-readable through /proc on these hosts.
BESZEL_HUB_URL=http://monitoring.homelab.chrison.internal:8090
BESZEL_AGENT_TOKEN=
BESZEL_HUB_KEY=

# ── OTel collector bearer token (Claude Code telemetry) ──
# Gates the OTLP/HTTP receiver on :4318, published by Pangolin as otel.lab.chrison.dev.
# Claude Code sends it as OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <this>".
# That hostname is sso:false — this token IS the only thing between the public internet
# and a write path into Prometheus, Tempo and Loki. Treat it accordingly.
# The LAN gRPC receiver on :4317 is deliberately unauthenticated (PowerOrchestrator, #191).
OTEL_BEARER_TOKEN=

# ── Grafana alerting → Home Assistant (#483 follow-up: UniFi monitoring) ──
# Full webhook URL for the HA automation "Grafana alerts → notification". Secret because
# an HA webhook id IS the capability — anyone on the LAN who knows it can fire the
# automation. Consumed as a podman secret by the grafana quadlet, which exposes it to
# Grafana's provisioned contact point as $HA_ALERT_WEBHOOK_URL.
HA_ALERT_WEBHOOK_URL=

# ── Rootless podman hosts: Cockpit login (#283 phase 3) ──
# Password for the `podman` user on every podman host. Exists ONLY so Cockpit can authenticate
# that user via PAM — rootless containers are visible only inside its own session, so root's
# Cockpit session shows nothing. Not consumed by any service; set by the provisioner when a
# shape declares `cockpit: true`.
PODMAN_USER_PASSWORD=
