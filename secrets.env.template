# ════════════════════════════════════════════════════════════════
# secrets.env.template — CANONICAL schema for secrets.env.
# Non-secret values are literal here; secret values are BLANK and get
# filled from Bitwarden Secrets Manager (project "Homelab") by:
#   scripts/secrets-sync.sh     (macOS/Linux)
#   scripts/secrets-sync.ps1    (Windows)
# NEVER put a secret value in this file — it is committed to git.
# ════════════════════════════════════════════════════════════════

# Cloudflare
CF_API_TOKEN=
CF_ACCOUNT_ID=
# GitHub org
GH_ORG=Chrison-Homelab
GH_RUNNER_PAT=
# ────────────────────────────────────────────────────────────────
# Network services — sourced by the CLIs (proxmoxsharp / synosharp /
# unifisharp). Source this file before running any tool:
#   set -a && . ./secrets.env && set +a
# ────────────────────────────────────────────────────────────────

# Proxmox VE (proxmoxsharp). Addressed BY NAME since #37 — the nodes moved to
# VLAN 1000 on 2026-08-02, and these are UniFi local-DNS records, so a future
# re-address needs no change here. Still VERIFY_TLS=false: this is the node's own
# self-signed cert. (https://proxmox.chrison.dev is the TLS-valid public path, via
# the Core cloudflared tunnel — use that from outside the LAN.)
PROXMOX_BASE_URL=https://hpe-01.homelab.chrison.internal:8006/api2/json
PROXMOX_TOKEN_ID="root@pam!claude-mcp"
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=false

# Synology DSM (synosharp). By name for the same reason — the NAS moved to
# 10.0.0.10 on VLAN 1000 (#340) and the DNS record is attached to its DHCP
# reservation, so name and lease move together.
SYNOLOGY_BASE_URL=https://nas.homelab.chrison.internal:5001
SYNOLOGY_USER=homelab
SYNOLOGY_PASSWORD=
SYNOLOGY_VERIFY_TLS=false

# UniFi Network (unifisharp) — LIVE Cloud Gateway Ultra.
# Needs a Network Integration API key (X-API-KEY), generated in the UniFi
# console: Settings → Control Plane → Integrations → Create API Key.
# Until set, live UniFi reads go through the unifi MCP (username/password).
# DELIBERATELY an IP, not a name: this host IS the DNS server. Pointing the
# controller's own address at a record it serves is circular — if UniFi is down or
# mid-boot, name resolution fails and you cannot reach the thing you need to fix.
UNIFI_BASE_URL=https://192.168.178.1/proxy/network/integration
UNIFI_VERIFY_TLS=false
# The `unifi` MCP (.mcp.json) uses local-API env names, not UNIFI_BASE_URL —
# it interpolates ${UNIFI_LOCAL_HOST} (+ shares UNIFI_API_KEY above). Without
# this it launches with an empty host → "nodename nor servname". Same controller.
UNIFI_LOCAL_HOST=192.168.178.1   # IP on purpose — see the note above
UNIFI_API_KEY=
# These two are ALSO what the legacy WRITE adapter uses (`converge-unifi`, and the
# DHCP-reservation reconcile): from Chrison.UnifiSharp 0.2.0 the legacy API accepts
# X-API-KEY and derives its site URL from UNIFI_LOCAL_HOST. Before that it demanded
# UNIFI_USERNAME + UNIFI_PASSWORD, which this file has never carried — so converge-unifi
# could not authenticate on ANY machine set up from here, including a bare-metal rebuild
# restoring the public :443 port-forward (#416). Session auth still works and is what
# `.containers/unifi` needs; set UNIFI_LEGACY_BASE_URL + UNIFI_USERNAME + UNIFI_PASSWORD
# for the test container only — never pointed at the live console, since the destructive
# UnifiSharp live tests key off exactly those variables.

# Home Assistant
HOMEASSISTANT_TOKEN=
# CF Access service token — non-interactive API access to proxmox.chrison.dev (Core tunnel)
CF_ACCESS_PROXMOX_CLIENT_ID=
CF_ACCESS_PROXMOX_CLIENT_SECRET=

# Homelab.Stacks.Media tunnel connector token (CT 5108)
CF_TUNNEL_MEDIA_TOKEN=
PANGOLIN_API_KEY=

