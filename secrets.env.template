# Pangolin Enterprise license (free personal tier, <$100k rev) — #168
PANGOLIN_LICENSE_KEY=

# Authentik — the homelab IdP on CT 2014 (#469). Both reach the CT as podman secrets.
#
# ⚠ AUTHENTIK_SECRET_KEY is not a rotatable password. It signs sessions AND encrypts values
# stored in the database, so losing it is worse than losing the database itself — the rows
# survive but cannot be decrypted. Rotating it logs every session out.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASSWORD=

# OIDC client credentials for the Pangolin application in Authentik (#468). BOTH sides read
# these same two values: Authentik's blueprint pins them via `!Env`, and Pangolin's IdP
# registration is created with them. Fixing the pair in Secrets Manager is what removes the
# "copy the client secret out of one UI and paste it into another" step — rotate by changing
# them here and re-running deploy-core, which updates both ends in one pass.
AUTHENTIK_PANGOLIN_CLIENT_ID=
AUTHENTIK_PANGOLIN_CLIENT_SECRET=

# OIDC client credentials for Pulse (#485). Same two-ended arrangement as Pangolin's:
# authentik's blueprint pins them via `!Env`, and Pulse reads them as OIDC_CLIENT_ID /
# OIDC_CLIENT_SECRET. Setting those env vars also LOCKS the fields in Pulse's own UI, so the
# deployed configuration cannot be edited out from under this file.
AUTHENTIK_PULSE_CLIENT_ID=
AUTHENTIK_PULSE_CLIENT_SECRET=

# OIDC client credentials for Grafana (#485). Read in three places: authentik's blueprint via
# `!Env`, and Grafana as GF_AUTH_GENERIC_OAUTH_CLIENT_ID / _SECRET. Note that authentik needs
# EVERY client's pair, not just its own — the blueprint declaring a provider is applied inside
# the authentik container, so a pair present only on the consumer's host resolves to null and
# authentik rejects the entire blueprint file.
AUTHENTIK_GRAFANA_CLIENT_ID=
AUTHENTIK_GRAFANA_CLIENT_SECRET=

# OIDC client credentials for Forgejo (#485). The forgejo provisioner passes these to
# `forgejo admin auth add-oauth`; authentik's blueprint pins the same pair via `!Env`.
AUTHENTIK_FORGEJO_CLIENT_ID=
AUTHENTIK_FORGEJO_CLIENT_SECRET=

# ── Shell host (CT 3003) — RETIRED, deliberately left here as a tombstone (#479).
#
# SHELL_USER_PASSWORD used to give the login account a password, because Pangolin's
# `mode: ssh` resource asks for the HOST's credentials after the SSO gate and a borrowed
# machine has no key file to upload. That resource is gone: the public surface is now
# Zellij's own web client, which needs no OS password at all.
#
# Leaving it OUT is the desired state. The provisioner reads its absence as an instruction:
# it locks the account AND drops /etc/ssh/sshd_config.d/10-homelab-keyonly.conf with
# PasswordAuthentication no — so the host refuses password auth outright rather than merely
# having no password to guess. Re-adding the key below reverses both.
#
# The corresponding Bitwarden Secrets Manager entry is now unused. Deleting it is yours to
# do (this file cannot, and should not, delete from the vault).

# ── PowerOrchestrator (#191) — dry-run; presence = iPhone Chris ──
ORCH_ARMED=false
ORCH_PRESENCE_MACS=12:c1:06:38:23:5b

# Observability: OTLP collector on the monitoring podman host (CT 4001 @ hpe-01) — #222/#303.
# A NAME, not an IP: the address moved once already in the podman migration, and the point
# of homelab.chrison.internal (UniFi local DNS) is that it never has to move again.
# Read by PowerOrchestrator/deploy/install.sh (OTEL_EXPORTER_* key) → orchestrator emits here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://monitoring.homelab.chrison.internal:4317

# Leapmotor Mate web-UI password (SmartHome podman host CT 6004) — #285.
# Consumed as a podman SECRET (not an env file) by podman-host/quadlets/leapmotor-mate.container.
# NOTE: MATE_SECRET_KEY is deliberately NOT registered — Mate auto-generates it into its
# data dir when unset, and it must stay paired with that database (see podman-host/README.md).
MATE_AUTH_PASSWORD=

# ── Youtarr on the Media podman host (CT 5114) — #302 ──
# Consumed as podman SECRETS (not an env file) by stacks/Media/podman-host/quadlets/.
YOUTARR_DB_ROOT_PASSWORD=
YOUTARR_AUTH_USERNAME=
YOUTARR_AUTH_PASSWORD=

# ── Krautwatch on the Media podman host (CT 5114) ──
# Consumed as podman SECRETS by stacks/Media/podman-host/quadlets/.
# The connection string is stored whole because a quadlet cannot expand a secret inside another
# variable's value. Its password must match KRAUTWATCH_DB_PASSWORD.
#   KRAUTWATCH_DB_CONNECTIONSTRING=Host=krautwatch-db;Port=5432;Username=postgres;Password=<same>;Database=krautwatch
KRAUTWATCH_DB_PASSWORD=
KRAUTWATCH_DB_CONNECTIONSTRING=
# The single API key Sonarr and Prowlarr authenticate with. Unset leaves the surface open.
KRAUTWATCH_APIKEY=
# Optional — TheTVDB matching. Absent degrades matching to titles rather than failing.
KRAUTWATCH_TVDB_APIKEY=

# ── Monitoring stack on the podman host (CT 4001) — #303 ──
# Consumed as podman SECRETS by stacks/monitoring/podman-host/quadlets/. These previously
# lived only in the stack's own .env.local on CT 4000 (see secrets.env.local.template),
# which is retired with that CT. Non-secret config (GF_SECURITY_ADMIN_USER, GRAFANA_PORT,
# the *arr URLs) is set as Environment= in the quadlets instead.
GF_SECURITY_ADMIN_PASSWORD=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# ── Pulse fleet monitoring on the podman host (CT 4001) — agent enrolment ──
# PULSE_API_TOKEN is Pulse's own API token (scope "*"). The unified agent enrols with
# the SAME token — agent registration needs HOST_AGENT_SCOPE, which "*" covers — so
# there is no second secret to mint or rotate.
#
# Consumed by src/Proxmox/install-pulse-agent.sh (+ .ps1) and
# src/Synology/install-pulse-agent.sh. Those pass it to the upstream installer via
# --token-file, never --token: argv is world-readable through /proc on these hosts.
PULSE_URL=http://monitoring.homelab.chrison.internal:7655
PULSE_API_TOKEN=

# ── Grafana alerting → Home Assistant (#483 follow-up: UniFi monitoring) ──
# Full webhook URL for the HA automation "Grafana alerts → notification". Secret because
# an HA webhook id IS the capability — anyone on the LAN who knows it can fire the
# automation. Consumed as a podman secret by the grafana quadlet, which exposes it to
# Grafana's provisioned contact point as $HA_ALERT_WEBHOOK_URL.
HA_ALERT_WEBHOOK_URL=

# ── Rootless podman hosts: Cockpit login (#283 phase 3) ──
# Password for the `podman` user on every podman host. Exists ONLY so Cockpit can authenticate
# that user via PAM — rootless containers are visible only inside its own session, so root's
# Cockpit session shows nothing. Not consumed by any service; set by the provisioner when a
# shape declares `cockpit: true`.
PODMAN_USER_PASSWORD=

# ── InvenTree parts inventory (CT 8000) — the superuser (#508) ──
# InvenTree's packaged install creates NO admin account, and its `invoke superuser` task
# is Django's interactive `createsuperuser` — so an unattended converge cannot use it.
# The `inventree` provisioner instead writes this value to /etc/inventree/admin_password.txt
# (0600) and points `admin_password_file` at it; InvenTree's own startup hook creates the
# account, and skips creation if the username already exists — so this is not a reset switch.
#
# ⚠ The file is read VERBATIM (apps.py does read_text() with no strip), which is why the
# provisioner writes it with printf and no trailing newline. A value with leading/trailing
# whitespace here becomes part of the password.
INVENTREE_ADMIN_PASSWORD=
