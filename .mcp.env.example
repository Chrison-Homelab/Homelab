# MCP server credentials template — copy to .mcp.env and fill in values
# Source before launching Claude Code: source .mcp.env

# Proxmox MCP — Samik081/mcp-pve (API token; tier pinned to read-only for discovery)
export PVE_HOST=""
export PVE_TOKEN_ID=""
export PVE_TOKEN_SECRET=""

# UniFi Network MCP — enuno/unifi-mcp-server (official API key, local gateway)
# API key: UniFi OS → Settings → Control Plane → Integrations → Create API Key
export UNIFI_API_KEY=""
export UNIFI_LOCAL_HOST=""   # gateway IP (Network Devices VLAN), e.g. 10.0.0.1
